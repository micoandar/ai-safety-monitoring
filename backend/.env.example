# ================================
# Application
# ================================
APP_NAME=AI Workplace Safety Monitoring System
APP_VERSION=0.1.0
DEBUG=True

# ================================
# Model
# ================================
MODEL_PATH=ai/best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640

# ================================
# Upload
# ================================
MAX_UPLOAD_SIZE_MB=10

# ================================
# CORS (comma-separated)
# ================================
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ================================
# Database (MySQL)
# ================================
# XAMPP default: root tanpa password
DATABASE_URL=mysql+pymysql://root:@localhost:3306/ppe_safety_monitoring

# Contoh dengan password:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/ppe_safety_monitoring

# Contoh production (cloud):
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/ppe_safety_monitoring?ssl_ca=/path/ca.pem